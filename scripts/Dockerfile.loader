# syntax=docker/dockerfile:1.7
# One-off data loader: migrations -> generate the 2M-row dataset -> COPY into Postgres -> checks.
# Runs as an ECS task inside the VPC (RDS isn't reachable from outside).
#   docker build -f scripts/Dockerfile.loader -t loader .
#   docker run --rm -e DATABASE_URL=... loader            # default: --full --generate
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 UV_LINK_MODE=copy
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv
WORKDIR /srv
COPY schema/generate_data.py schema/seed_data.sql schema/create_tables.sql ./schema/
COPY db ./db
COPY scripts/load_data.py ./scripts/
# Resolve the script's inline dependencies at build time (no downloads when the task runs).
RUN uv run --script scripts/load_data.py --help > /dev/null
ENTRYPOINT ["uv", "run", "--script", "scripts/load_data.py"]
CMD ["--full", "--generate"]
