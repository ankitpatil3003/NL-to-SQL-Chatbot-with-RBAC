# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=pharma
POSTGRES_PASSWORD=pharma_dev_pw
POSTGRES_DB=pharma
DATABASE_URL=postgresql+asyncpg://pharma:pharma_dev_pw@localhost:5433/pharma

# Least-privilege DB logins that execute LLM-generated SQL (db/20_rbac.sql)
DB_SCOPED_READER_PASSWORD=scoped_reader_dev_pw
DB_EXEC_READER_PASSWORD=exec_reader_dev_pw

# --- Auth ---
# Outside APP_ENV=local this must be a random 32+ char value or the API refuses to start.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=720
# One shared password for all 23 demo users (bcrypt-hashed at API startup; rotate by changing it).
DEMO_PASSWORD=novapharma-demo
# Show the demo accounts + password on the login page.
DEMO_SHOW_CREDENTIALS=true

# --- LLM providers ---
# Chain = ordered provider:model targets; the router retries once, then falls back to the next.
# Providers without a key are skipped. Per-task overrides: LLM_CHAIN_SQL / _ROUTER / _REWRITE /
# _ANSWER / _TITLE. Default (chosen by eval): free Nemotron, then Claude as the paid fallback.
LLM_CHAIN=openrouter:nvidia/nemotron-3-super-120b-a12b:free,anthropic:claude-sonnet-5
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
