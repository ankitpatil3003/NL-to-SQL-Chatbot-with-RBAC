# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=pharma
POSTGRES_PASSWORD=pharma_dev_pw
POSTGRES_DB=pharma
DATABASE_URL=postgresql+asyncpg://pharma:pharma_dev_pw@localhost:5433/pharma

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=720

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
